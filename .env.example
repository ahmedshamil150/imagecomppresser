# Absolute URL of the deployed site — used for canonical URLs, sitemap, Open Graph and llms.txt links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown on contact, about and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Google AdSense publisher ID (ca-pub-xxxxxxxxxxxxxxxx). Leave empty to disable ads entirely.
NEXT_PUBLIC_ADSENSE_CLIENT=
